# Copy this file to .env and fill in your own values. .env is gitignored — never commit it.

# Password required to access /admin (Match Entry, Roster, Players, Seasons management).
ADMIN_PASSWORD=changeme

# Optional. Random string used to sign session cookies. Leave as-is (or delete the line)
# and a random one is generated and stored in the database instead.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_SECRET=changeme

# Port the server listens on (optional, defaults to 4173).
# PORT=4173
